{
  "templates": {
    "classic": "<!DOCTYPE html>\n<html lang=\"{{lang}}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<title>{{title}}</title>\n<link rel=\"stylesheet\" href=\"/.within.website/x/cmd/anubis/static/css/xess.css\">\n<style>html,body{min-height:100%;margin:0}body{display:grid;place-items:center;padding:2rem;box-sizing:border-box}main{width:min(100%,42rem);text-align:center}img{width:100%;max-width:256px}openflare-pow{display:block;margin:1.5rem auto}details{margin:2rem auto;max-width:36rem}</style>\n</head>\n<body>\n<main>\n<h1>{{title}}</h1>\n<img src=\"/.within.website/x/cmd/anubis/static/img/pensive.webp\" alt=\"\">\n<p>{{status}}</p>\n{{widget}}\n<p>{{protected}}</p>\n<details><summary>{{why}}</summary><p>{{why_description}}</p></details>\n<noscript><p>{{noscript}}</p></noscript>\n</main>\n</body>\n</html>\n",
    "shield": "<!DOCTYPE html>\n<html lang=\"{{lang}}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<title>{{title}}</title>\n<style>:root{color-scheme:light dark;--bg:#fff;--fg:#313131;--muted:#686868;--line:#ddd}@media(prefers-color-scheme:dark){:root{--bg:#181818;--fg:#eee;--muted:#aaa;--line:#444}}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 system-ui,sans-serif;min-height:100vh;display:flex;flex-direction:column}main{width:min(100% - 3rem,60rem);margin:12vh auto 3rem;flex:1}h1{font-size:clamp(1.75rem,5vw,2.5rem);line-height:1.25;font-weight:500;overflow-wrap:anywhere}h2{font-size:1.4rem;font-weight:500}p{color:var(--muted)}openflare-pow{display:block;margin:2rem 0}footer{border-top:1px solid var(--line);padding:1.25rem;text-align:center;font-size:.8rem;color:var(--muted)}details{margin-top:3rem;max-width:48rem}summary{cursor:pointer}</style>\n</head>\n<body>\n<main>\n<h1>{{host}}</h1>\n<h2>{{title}}</h2>\n<p>{{status}}</p>\n{{widget}}\n<details><summary>{{why}}</summary><p>{{why_description}}</p></details>\n<noscript><p>{{noscript}}</p></noscript>\n</main>\n<footer>{{protected}}</footer>\n</body>\n</html>\n"
  },
  "widget": "// Copyright 2026 Arctel.net\n// SPDX-License-Identifier: Apache-2.0\n\nlet state = Object.freeze({ status: 'loading', progress: 0, message: '' });\n\nexport function updateState(change) {\n  state = Object.freeze({ ...state, ...change });\n  window.dispatchEvent(new CustomEvent('openflare:pow', { detail: state }));\n}\n\nwindow.OpenFlarePoW = Object.freeze({\n  get state() { return state; },\n  subscribe(callback) {\n    callback(state);\n    const listener = (event) => callback(event.detail);\n    window.addEventListener('openflare:pow', listener);\n    return () => window.removeEventListener('openflare:pow', listener);\n  },\n  retry() { window.location.reload(); },\n});\n\nclass OpenFlarePoW extends HTMLElement {\n  connectedCallback() {\n    if (!this.shadowRoot) {\n      this.attachShadow({ mode: 'open' }).innerHTML = `\n        <style>\n        :host{display:block;max-width:340px;font:14px/1.5 system-ui,sans-serif;color:#313131;--surface:#fafafa;--line:#d8d8d8;--accent:#b16286;--success:#238636;--error:#bc3030}\n        @media(prefers-color-scheme:dark){:host{color:#eee;--surface:#242424;--line:#555;--accent:#d386b4;--success:#5fbc6d;--error:#ff8080}}\n        .box{display:flex;align-items:center;gap:16px;padding:16px;border:1px solid var(--line);border-radius:4px;background:var(--surface);min-height:76px;text-align:left}\n        .icon{width:25px;height:25px;flex:none;box-sizing:border-box;border:3px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite}\n        .brand{margin-left:auto;font-size:10px;letter-spacing:.04em;color:inherit;opacity:.65}\n        .track{height:12px;background:var(--line);border-radius:8px;overflow:hidden;margin-top:10px}\n        .bar{height:100%;background:var(--accent);width:0;transition:width .25s ease}\n        .message{overflow-wrap:anywhere}.value{font-variant-numeric:tabular-nums;white-space:nowrap}\n        :host([appearance=\"turnstile\"]) .track,:host([appearance=\"turnstile\"]) .value{display:none}\n        :host(:not([appearance=\"turnstile\"])) .box{display:block;border:0;background:transparent;padding:0;text-align:inherit}\n        :host(:not([appearance=\"turnstile\"])) .icon,:host(:not([appearance=\"turnstile\"])) .brand{display:none}\n        .box[data-status=\"success\"] .icon{border:0;border-radius:0;animation:none;color:var(--success)}\n        .box[data-status=\"success\"] .icon::after{content:'✓';font-size:28px;line-height:1}\n        .box[data-status=\"error\"] .icon{border:0;animation:none;color:var(--error)}\n        .box[data-status=\"error\"] .icon::after{content:'!';font-size:28px;line-height:1}\n        button{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:4px;padding:5px 12px;margin-top:10px;cursor:pointer}\n        [hidden]{display:none!important}@keyframes spin{to{transform:rotate(360deg)}}\n        @media(prefers-reduced-motion:reduce){.icon{animation-duration:3s}.bar{transition:none}}\n        </style>\n        <div class=\"box\" data-status=\"loading\">\n          <span class=\"icon\" aria-hidden=\"true\"></span>\n          <div style=\"flex:1;min-width:0\">\n            <span class=\"message\" role=\"status\" aria-live=\"polite\"></span>\n            <span class=\"value\" aria-hidden=\"true\"></span>\n            <div class=\"track\" role=\"progressbar\" aria-label=\"PoW\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"bar\"></div></div>\n            <button type=\"button\" hidden></button>\n          </div>\n          <span class=\"brand\">OpenFlare</span>\n        </div>`;\n      const retry = this.shadowRoot.querySelector('button');\n      retry.addEventListener('click', () => window.OpenFlarePoW.retry());\n    }\n    this.unsubscribe?.();\n    this.unsubscribe = window.OpenFlarePoW.subscribe((value) => {\n      const root = this.shadowRoot;\n      const progress = Math.round(Math.max(0, Math.min(100, value.progress)));\n      root.querySelector('.box').dataset.status = value.status;\n      root.querySelector('.message').textContent = value.message;\n      root.querySelector('.value').textContent = ` ${progress}%`;\n      root.querySelector('.bar').style.width = `${progress}%`;\n      root.querySelector('.track').setAttribute('aria-valuenow', String(progress));\n      root.querySelector('button').textContent = value.retryLabel || 'Try again';\n      root.querySelector('button').hidden = value.status !== 'error';\n    });\n  }\n  disconnectedCallback() { this.unsubscribe?.(); }\n}\n\nif (!customElements.get('openflare-pow')) customElements.define('openflare-pow', OpenFlarePoW);\n",
  "css": ":root {\n  --body-sans-font: Geist, sans-serif;\n  --body-preformatted-font: Iosevka Curly Iaso, monospace;\n  --body-title-font: Podkova, serif;\n\n  --background: #1d2021;\n  --text: #f9f5d7;\n  --text-selection: #d3869b;\n  --preformatted-background: #3c3836;\n  --link-foreground: #b16286;\n  --link-background: #282828;\n  --blockquote-border-left: 1px solid #bdae93;\n\n  --progress-bar-outline: #b16286 solid 4px;\n  --progress-bar-fill: #b16286;\n}\n@media (prefers-color-scheme: light) {\n  :root {\n    --background: #f9f5d7;\n    --text: #1d2021;\n    --text-selection: #d3869b;\n    --preformatted-background: #ebdbb2;\n    --link-foreground: #b16286;\n    --link-background: #fbf1c7;\n    --blockquote-border-left: 1px solid #655c54;\n  }\n}\n\n@font-face {\n  font-family: \"Geist\";\n  font-style: normal;\n  font-weight: 100 900;\n  font-display: swap;\n  src: url(\"./static/geist.woff2\") format(\"woff2\");\n}\n\n@font-face {\n  font-family: \"Podkova\";\n  font-style: normal;\n  font-weight: 400 800;\n  font-display: swap;\n  src: url(\"./static/podkova.woff2\") format(\"woff2\");\n}\n\n@font-face {\n  font-family: \"Iosevka Curly\";\n  font-style: monospace;\n  font-display: swap;\n  src: url(\"./static/iosevka-curly.woff2\") format(\"woff2\");\n}\n\nmain {\n  font-family: var(--body-sans-font);\n  max-width: 50rem;\n  padding: 2rem;\n  margin: auto;\n}\n\n::selection {\n  background: var(--text-selection);\n}\n\nbody {\n  background: var(--background);\n  color: var(--text);\n}\n\nbody,\nhtml {\n  height: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.centered-div {\n  text-align: center;\n}\n\n#status {\n  font-variant-numeric: tabular-nums;\n}\n\n.centered-div {\n  text-align: center;\n}\n\n#status {\n  font-variant-numeric: tabular-nums;\n}\n\n#progress {\n  display: none;\n  width: min(20rem, 90%);\n  height: 2rem;\n  border-radius: 1rem;\n  overflow: hidden;\n  margin: 1rem 0 2rem;\n  outline-offset: 2px;\n  outline: var(--progress-bar-outline);\n}\n\n.bar-inner {\n  background-color: var(--progress-bar-fill);\n  height: 100%;\n  width: 0;\n  transition: width 0.25s ease-in;\n}\n\n@media (prefers-reduced-motion: no-preference) {\n  .bar-inner {\n    transition: width 0.25s ease-in;\n  }\n}\n\npre {\n  background-color: var(--preformatted-background);\n  padding: 1em;\n  border: 0;\n  font-family: var(--body-preformatted-font);\n}\n\na,\na:active,\na:visited {\n  color: var(--link-foreground);\n  background-color: var(--link-background);\n}\n\nh1,\nh2,\nh3,\nh4,\nh5 {\n  margin-bottom: 0.1rem;\n  font-family: var(--body-title-font);\n}\n\nblockquote {\n  border-left: var(--blockquote-border-left);\n  margin: 0.5em 10px;\n  padding: 0.5em 10px;\n}\n\nfooter {\n  text-align: center;\n}\n",
  "image": ""
}

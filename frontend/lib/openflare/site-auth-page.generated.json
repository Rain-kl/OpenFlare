"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>身份验证 · Site sign-in</title>\n  <style>\n    :root { color-scheme: light dark; font: 16px/1.5 system-ui, sans-serif; }\n    body { margin: 0; min-height: 100dvh; display: grid; place-items: center; background: Canvas; color: CanvasText; }\n    main { width: min(22rem, calc(100% - 3rem)); }\n    h1 { margin: 0 0 1.5rem; font-size: 1.65rem; letter-spacing: -.02em; }\n    form, label { display: grid; gap: .625rem; }\n    form { gap: 1rem; }\n    label { font-size: .9rem; }\n    input, button { box-sizing: border-box; width: 100%; border-radius: .5rem; padding: .65rem .8rem; font: inherit; }\n    input { border: 1px solid GrayText; background: Field; color: FieldText; }\n    button { border: 1px solid transparent; background: #1959c6; color: white; cursor: pointer; }\n    p { margin: 0; color: #cd4237; }\n    p:empty { display: none; }\n  </style>\n</head>\n<body>\n  <main>\n    <h1>身份验证</h1>\n    <form method=\"post\">\n      <label>用户名 / Username <input name=\"username\" autocomplete=\"username\" required autofocus></label>\n      <label>密码 / Password <input type=\"password\" name=\"password\" autocomplete=\"current-password\" required></label>\n      <p role=\"alert\">{{login_error}}</p>\n      <button type=\"submit\">登录 / Sign in</button>\n    </form>\n  </main>\n</body>\n</html>\n"

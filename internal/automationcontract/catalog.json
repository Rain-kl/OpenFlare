  {
    "id": "openflare_site_create",
    "cli": "site create",
    "method": "POST",
    "path": "/sites",
    "scope": "sites:write",
    "effect": "write",
    "description": "Create one enabled site with the specified unbound domain records and direct upstreams. Resolve domain_record_ids with openflare_domain_list. The result confirms controller storage only; check node status after synchronization. DNS is unchanged.",
    "parameters": [
      {
        "name": "domain_record_ids",
        "in": "body",
        "required": true,
        "description": "Unbound domain record IDs from openflare_domain_list. Use decimal strings, not hostnames.",
        "schema": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      {
        "name": "enable_https",
        "in": "body",
        "required": true,
        "description": "True enables browser-facing HTTPS and requires a covering certificate on each domain. False serves HTTP only. Independent of upstream URL schemes.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "origin_host",
        "in": "body",
        "description": "Optional upstream Host override. If omitted, use normal edge Host handling.",
        "schema": {
          "maxLength": 253,
          "type": "string"
        }
      },
      {
        "name": "site_name",
        "in": "body",
        "required": true,
        "description": "Unique display name for the new site.",
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      {
        "name": "upstreams",
        "in": "body",
        "required": true,
        "description": "Ordered direct HTTP(S) URLs including scheme and optional port. No credentials, query strings or fragments. Multiple upstreams must share a scheme and have no path prefix.",
        "schema": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      }
    ],
    "output": {
      "properties": {
        "site": {
          "properties": {
            "domains": {
              "items": {
                "properties": {
                  "certificate_id": {
                    "type": "string"
                  },
                  "domain_record_id": {
                    "type": "string"
                  },
                  "hostname": {
                    "type": "string"
                  },
                  "site_id": {
                    "type": "string"
                  },
                  "zone_id": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "enabled": {
              "type": "boolean"
            },
            "https_enabled": {
              "type": "boolean"
            },
            "origin_host": {
              "type": "string"
            },
            "site_id": {
              "type": "string"
            },
            "site_name": {
              "type": "string"
            },
            "upstream_type": {
              "type": "string"
            },
            "upstreams": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "state": {
          "type": "string"
        }
      },
      "type": "object"
    }

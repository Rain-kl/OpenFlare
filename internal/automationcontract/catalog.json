  {
    "id": "openflare_certificate_list",
    "cli": "certificate list",
    "method": "GET",
    "path": "/certificates",
    "scope": "sites:read",
    "effect": "read",
    "description": "Return certificate IDs, configured hostnames, expiration and issuance status. Select a ready certificate covering the target hostname. No private keys or certificate files are returned.",
    "parameters": [],
    "output": {
      "properties": {
        "results": {
          "items": {
            "properties": {
              "certificate_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "not_after": {
                "type": "string"
              },
              "other_domains": {
                "type": "string"
              },
              "primary_domain": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  {

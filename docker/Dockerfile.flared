# syntax=docker/dockerfile:1.7
ARG VERSION=dev

FROM golang:alpine AS builder

ARG VERSION

ENV GOTOOLCHAIN=""

WORKDIR /build
COPY go.mod go.sum ./
RUN --mount=type=bind,source=docker/go-toolchain.sh,target=/tmp/go-toolchain.sh \
    --mount=type=cache,target=/go/pkg/mod \
    sh /tmp/go-toolchain.sh && go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w -X 'github.com/Rain-kl/Wavelet/internal/edge/flared/config.Version=$VERSION'" -o flared ./cmd/flared/main.go

# Final runtime image
FROM fatedier/frpc:v0.69.0

WORKDIR /app

# Copy openflared binary
COPY --from=builder /build/flared .

ENV OPENFLARE_DATA_DIR=/app/data
ENV OPENFLARE_FRPC_PATH=/usr/bin/frpc

ENTRYPOINT ["/app/flared"]
CMD []

# syntax=docker/dockerfile:1.7
FROM rust:1.95-alpine3.23 AS builder

WORKDIR /build/edge/pingora
RUN apk add --no-cache build-base ca-certificates cmake git perl pkgconf
COPY edge/pingora/Cargo.toml edge/pingora/Cargo.lock ./
COPY edge/pingora/src/ src/
COPY edge/pingora/vendor/ vendor/
COPY probe/ /build/probe/
COPY internal/openflare/edgeconfig/pow_static/ /build/internal/openflare/edgeconfig/pow_static/
COPY internal/openflare/edgeconfig/pow_templates/ /build/internal/openflare/edgeconfig/pow_templates/
COPY internal/openflare/edgeconfig/site_auth.html /build/internal/openflare/edgeconfig/
ARG VERSION=dev
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=edge-musl-cargo-target-${TARGETARCH},target=/target \
    OPENFLARE_EDGE_VERSION="${VERSION#edge-v}" CARGO_PROFILE_RELEASE_STRIP=symbols \
    CARGO_TARGET_DIR=/target cargo build --locked --release \
    && install -D -m 0755 /target/release/openflare-edge /out/openflare-edge \
    && elf="$(readelf --program-headers --dynamic --wide /out/openflare-edge)" \
    && ! printf '%s\n' "$elf" | grep -E 'INTERP|\(NEEDED\)'

FROM alpine:3.23 AS runtime

RUN test -s /etc/ssl/certs/ca-certificates.crt \
    && addgroup -S -g 10001 openflare-edge \
    && adduser -S -D -H -u 10001 -G openflare-edge -s /sbin/nologin openflare-edge \
    && install -d -m 0750 -o openflare-edge -g openflare-edge /var/lib/openflare-edge

COPY --chmod=0755 docker/entrypoints/edge-entrypoint.sh /usr/local/bin/edge-entrypoint
COPY --from=builder /out/openflare-edge /usr/local/bin/openflare-edge

ARG VERSION=dev
ARG SOURCE_URL=https://github.com/Rain-kl/OpenFlare
LABEL org.opencontainers.image.source=$SOURCE_URL \
      org.opencontainers.image.version=$VERSION

VOLUME ["/var/lib/openflare-edge"]
EXPOSE 8080/tcp 8443/tcp
USER 10001:10001
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --start-period=30s --timeout=3s CMD test -s "${OPENFLARE_EDGE_STATE_DIR:-/var/lib/openflare-edge}/ready.json"
ENTRYPOINT ["/usr/local/bin/edge-entrypoint"]
